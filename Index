<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Calendrier perpétuel</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Segoe UI', Roboto, system-ui, sans-serif;
      background: linear-gradient(145deg, #f0f4fa 0%, #d9e2ed 100%);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1rem;
    }

    .calendar-container {
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(10px);
      max-width: 500px;
      width: 100%;
      border-radius: 2.5rem;
      box-shadow: 0 25px 40px -10px rgba(0, 20, 30, 0.3),
                  inset 0 1px 4px rgba(255, 255, 255, 0.8);
      padding: 1.8rem 1.8rem 2rem;
      border: 1px solid rgba(255, 255, 255, 0.6);
    }

    .calendar-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1.5rem;
    }

    .month-year {
      font-size: 1.7rem;
      font-weight: 600;
      color: #1a2b3e;
      letter-spacing: 0.02em;
      text-transform: capitalize;
      background: linear-gradient(135deg, #1e3c5c, #2e577b);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .nav-buttons {
      display: flex;
      gap: 0.8rem;
    }

    .nav-btn {
      background: white;
      border: none;
      width: 2.8rem;
      height: 2.8rem;
      border-radius: 1.2rem;
      font-size: 1.4rem;
      font-weight: 500;
      color: #2e4b6b;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.03), 0 0 0 1px rgba(255, 255, 255, 0.7) inset;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s ease;
      line-height: 1;
      user-select: none;
    }

    .nav-btn:hover {
      background: #e6eef9;
      box-shadow: 0 8px 16px rgba(0, 30, 50, 0.1), 0 0 0 1px rgba(255, 255, 255, 0.8) inset;
      transform: scale(1.03);
      color: #0f2a42;
    }

    .nav-btn:active {
      transform: scale(0.96);
      background: #d3e0f0;
    }

    .weekdays {
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      text-align: center;
      font-weight: 600;
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: #3f5e7a;
      margin-bottom: 0.8rem;
      padding: 0 0.2rem;
    }

    .weekdays span {
      padding: 0.4rem 0;
    }

    .days-grid {
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      gap: 0.3rem;
      background: transparent;
    }

    .day-cell {
      display: flex;
      align-items: center;
      justify-content: center;
      aspect-ratio: 1 / 1;
      border-radius: 1.2rem;
      font-weight: 500;
      font-size: 1rem;
      color: #1d2f40;
      background: transparent;
      transition: all 0.15s ease;
      cursor: default;
      user-select: none;
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.3);
    }

    .day-cell.other-month {
      color: #9aaec2;
      font-weight: 400;
    }

    .day-cell.today {
      background: linear-gradient(135deg, #1a4971, #1e6a9c);
      color: white;
      font-weight: 600;
      box-shadow: 0 8px 18px -4px #1a4971a0, 0 0 0 2px rgba(255, 255, 255, 0.5) inset;
      transform: scale(1.02);
    }

    .day-cell:not(.other-month):hover {
      background: rgba(200, 220, 245, 0.5);
      box-shadow: inset 0 0 0 1.5px rgba(255, 255, 255, 0.8);
    }

    .footer-actions {
      display: flex;
      justify-content: center;
      margin-top: 1.6rem;
    }

    .today-btn {
      background: white;
      border: none;
      padding: 0.75rem 2.2rem;
      border-radius: 3rem;
      font-weight: 500;
      color: #1e4a73;
      box-shadow: 0 6px 14px rgba(0, 0, 0, 0.03), 0 0 0 1px rgba(255, 255, 255, 0.9) inset;
      cursor: pointer;
      font-size: 0.95rem;
      letter-spacing: 0.02em;
      transition: all 0.2s ease;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .today-btn:hover {
      background: #e6eef9;
      box-shadow: 0 10px 20px rgba(0, 40, 70, 0.1), 0 0 0 1px white inset;
      transform: translateY(-1px);
    }

    .today-btn:active {
      transform: translateY(1px);
      background: #d0ddec;
    }

    /* petit indicateur de l'année pour le fun */
    .year-badge {
      font-size: 0.7rem;
      background: #1e4a7330;
      border-radius: 20px;
      padding: 0.15rem 0.6rem;
      color: #1e4a73;
      font-weight: 500;
      margin-left: 0.5rem;
      vertical-align: middle;
    }
  </style>
</head>
<body>
  <div class="calendar-container">
    <!-- En-tête avec mois/année et navigation -->
    <div class="calendar-header">
      <div class="month-year" id="monthYearDisplay">
        Janvier <span class="year-badge" id="yearBadge">2025</span>
      </div>
      <div class="nav-buttons">
        <button class="nav-btn" id="prevMonthBtn" aria-label="Mois précédent">←</button>
        <button class="nav-btn" id="nextMonthBtn" aria-label="Mois suivant">→</button>
      </div>
    </div>

    <!-- Jours de la semaine -->
    <div class="weekdays">
      <span>Lun</span>
      <span>Mar</span>
      <span>Mer</span>
      <span>Jeu</span>
      <span>Ven</span>
      <span>Sam</span>
      <span>Dim</span>
    </div>

    <!-- Grille des jours -->
    <div class="days-grid" id="daysGrid"></div>

    <!-- Bouton "Aujourd'hui" -->
    <div class="footer-actions">
      <button class="today-btn" id="todayBtn">
        <span>📅</span> Aujourd'hui
      </button>
    </div>
  </div>

  <script>
    (function() {
      // ----- État du calendrier -----
      let currentYear = new Date().getFullYear();
      let currentMonth = new Date().getMonth(); // 0 = janvier

      // ----- Éléments DOM -----
      const monthYearDisplay = document.getElementById('monthYearDisplay');
      const yearBadge = document.getElementById('yearBadge');
      const daysGrid = document.getElementById('daysGrid');
      const prevBtn = document.getElementById('prevMonthBtn');
      const nextBtn = document.getElementById('nextMonthBtn');
      const todayBtn = document.getElementById('todayBtn');

      // ----- Noms des mois en français -----
      const monthNames = [
        'Janvier', 'Février', 'Mars', 'Avril', 'Mai', 'Juin',
        'Juillet', 'Août', 'Septembre', 'Octobre', 'Novembre', 'Décembre'
      ];

      // ----- Fonction utilitaire : nombre de jours dans un mois -----
      function daysInMonth(year, month) {
        return new Date(year, month + 1, 0).getDate();
      }

      // ----- Obtenir le premier jour du mois (0 = dimanche ... 6 = samedi) -----
      // Mais on veut commencer la semaine le lundi (0 = lundi ... 6 = dimanche)
      function getFirstDayOfMonth(year, month) {
        let jsDay = new Date(year, month, 1).getDay(); // 0 = dim, 1 = lun, ... 6 = sam
        // Conversion pour semaine commençant lundi:
        // dimanche (0) -> 6, lundi (1) -> 0, mardi (2) -> 1, etc.
        return (jsDay === 0) ? 6 : jsDay - 1;
      }

      // ----- Rendu principal -----
      function renderCalendar() {
        // Mise à jour du titre (mois + année)
        const monthName = monthNames[currentMonth];
        monthYearDisplay.innerHTML = `${monthName} <span class="year-badge" id="yearBadge">${currentYear}</span>`;

        // Préparation de la grille
        daysGrid.innerHTML = '';

        const firstDayIndex = getFirstDayOfMonth(currentYear, currentMonth); // 0 = lundi
        const totalDays = daysInMonth(currentYear, currentMonth);

        // Mois précédent (pour les cases grisées)
        const prevMonthYear = currentMonth === 0 ? currentYear - 1 : currentYear;
        const prevMonth = currentMonth === 0 ? 11 : currentMonth - 1;
        const daysInPrevMonth = daysInMonth(prevMonthYear, prevMonth);

        // Date du jour (pour le surlignage)
        const today = new Date();
        const todayYear = today.getFullYear();
        const todayMonth = today.getMonth();
        const todayDate = today.getDate();

        // 1. Cases du mois précédent (du lundi au dimanche précédant le 1er)
        for (let i = firstDayIndex - 1; i >= 0; i--) {
          const dayNumber = daysInPrevMonth - i;
          const cell = document.createElement('div');
          cell.className = 'day-cell other-month';
          cell.textContent = dayNumber;
          daysGrid.appendChild(cell);
        }

        // 2. Cases du mois courant
        for (let day = 1; day <= totalDays; day++) {
          const cell = document.createElement('div');
          cell.className = 'day-cell';
          cell.textContent = day;

          // Vérifier si c'est aujourd'hui
          if (currentYear === todayYear && currentMonth === todayMonth && day === todayDate) {
            cell.classList.add('today');
          }

          daysGrid.appendChild(cell);
        }

        // 3. Cases du mois suivant (compléter la grille jusqu'à un multiple de 7)
        const totalCells = firstDayIndex + totalDays;
        const remainingCells = (7 - (totalCells % 7)) % 7; // pour éviter 7 si déjà multiple
        for (let i = 1; i <= remainingCells; i++) {
          const cell = document.createElement('div');
          cell.className = 'day-cell other-month';
          cell.textContent = i;
          daysGrid.appendChild(cell);
        }
      }

      // ----- Navigation -----
      function goToPreviousMonth() {
        if (currentMonth === 0) {
          currentMonth = 11;
          currentYear--;
        } else {
          currentMonth--;
        }
        renderCalendar();
      }

      function goToNextMonth() {
        if (currentMonth === 11) {
          currentMonth = 0;
          currentYear++;
        } else {
          currentMonth++;
        }
        renderCalendar();
      }

      function goToToday() {
        const now = new Date();
        currentYear = now.getFullYear();
        currentMonth = now.getMonth();
        renderCalendar();
      }

      // ----- Attacher les événements -----
      prevBtn.addEventListener('click', goToPreviousMonth);
      nextBtn.addEventListener('click', goToNextMonth);
      todayBtn.addEventListener('click', goToToday);

      // ----- Premier rendu -----
      renderCalendar();

      // Optionnel : mise à jour automatique si l'onglet reste ouvert longtemps (pas nécessaire mais sympa)
      // On peut rafraîchir le "today" à minuit, mais on garde simple.
    })();
  </script>
</body>
</html>
